---
import FormattedDate from '@components/FormattedDate.astro';
import PostList from '@components/PostList.astro';
import ProjectCards from '@components/ProjectCards.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { HOME_TIME_ZONE, NEXT_GAME, NOW, SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);

const game = NEXT_GAME && new Date(NEXT_GAME.date) > new Date() ? NEXT_GAME : null;
const gameTime =
	game &&
	new Date(game.date).toLocaleString('en-US', {
		weekday: 'short',
		month: 'short',
		day: 'numeric',
		hour: 'numeric',
		minute: '2-digit',
		timeZone: HOME_TIME_ZONE,
	});
const projects = (await getCollection('projects')).sort(
	(a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---

<BaseLayout title='Ethan Morris' description={SITE_DESCRIPTION}>
	<section class='intro' aria-labelledby='intro-title'>
		<h1 id='intro-title' class='rise' style='--i: 0'>Ethan Morris</h1>
		<p class='lede rise' style='--i: 1'>
			Director of development, dad of two, and a winger who picked up hockey at 36.
		</p>
		<p class='rise' style='--i: 2'>
			I lead development at <a href='https://centralstatesmarketing.com'>Central States Marketing</a>. Before that I spent
			eight years as a financial advisor. This is where I write about front-end details and keep the things I'm building,
			finished or not.
		</p>
		<p class='now rise' style='--i: 3'>
			<span class='now-label'>Now</span>
			<span>{NOW.text}</span>
			<span class='meta now-date'>Updated <FormattedDate date={NOW.updated} style='short' /></span>
		</p>
		{
			game && (
				<p class='now game rise' style='--i: 4' data-starts={game.date}>
					<span class='now-label game-label'>Next game</span>
					<span>
						Bombers vs. {game.opponent}, <time datetime={game.date}>{gameTime}</time>
						{game.rink && <span class='meta'> at {game.rink}</span>}
					</span>
				</p>
			)
		}
	</section>

	<section class='section full' aria-labelledby='projects-title'>
		<ProjectCards projects={projects}>
			<h2 slot='head' id='projects-title'>Projects</h2>
		</ProjectCards>
	</section>

	<section class='section' aria-labelledby='writing-title'>
		<div class='section-head'>
			<h2 id='writing-title'>Writing</h2>
			<a class='quiet-link' href='/blog'>All posts <span class='arrow'>→</span></a>
		</div>
		<PostList posts={posts} />
	</section>
</BaseLayout>

<script>
	// Hide the next game once it has started (the page itself may be older than that).
	function hidePastGame() {
		const game = document.querySelector<HTMLElement>('.game[data-starts]');
		if (game && new Date(game.dataset.starts!).getTime() < Date.now()) game.hidden = true;
	}
	document.addEventListener('astro:page-load', hidePastGame);
</script>

<style>
	.intro {
		padding-top: clamp(0rem, 4vw, 3rem);
	}
	.intro h1 {
		margin-bottom: 0.35em;
		font-size: var(--fs-display);
		letter-spacing: -0.035em;
	}
	.intro p {
		max-width: 54ch;
		color: var(--ink-2);
	}
	.lede {
		color: var(--ink) !important;
		font-weight: 550;
		text-wrap: balance;
		font-size: var(--fs-md);
		line-height: 1.45;
	}
	.now {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		gap: 0.15rem 1rem;
		margin-top: 2rem;
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		color: var(--ink) !important;
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	.now-label {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		color: var(--accent-ink);
		font-weight: 700;
	}
	.now {
		max-width: 62ch !important;
	}
	.game {
		margin-top: 0.75rem;
		border-top: 0;
		padding-top: 0;
	}
	.game .game-label::before {
		background-color: transparent;
		box-shadow: inset 0 0 0 1.5px var(--accent);
	}
	.now-date {
		grid-column: 2;
	}
	.now-label::before {
		border-radius: 50%;
		background-color: var(--accent);
		width: 7px;
		height: 7px;
		content: '';
	}
</style>
