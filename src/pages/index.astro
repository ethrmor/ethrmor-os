---
import FormattedDate from '@components/FormattedDate.astro';
import PostList from '@components/PostList.astro';
import ProjectList from '@components/ProjectList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { NOW, SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getCollection('projects')).sort(
	(a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---

<BaseLayout title='Ethan Morris' description={SITE_DESCRIPTION}>
	<section class='intro' aria-labelledby='intro-title'>
		<h1 id='intro-title' class='rise' style='--i: 0'>Ethan Morris</h1>
		<p class='lede rise' style='--i: 1'>
			I build websites at <a href='https://centralstatesmarketing.com'>Central States Marketing</a>. Before that I spent
			eight years as a financial advisor, which still shows up in what I make.
		</p>
		<p class='rise' style='--i: 2'>
			This is where I write about small front-end details and keep the things I'm building, finished or not.
		</p>
		<p class='now rise' style='--i: 3'>
			<span class='now-label'>Now</span>
			<span>{NOW.text}</span>
			<span class='meta'>Updated <FormattedDate date={NOW.updated} style='short' /></span>
		</p>
	</section>

	<section class='section full' aria-labelledby='projects-title'>
		<div class='section-head'>
			<h2 id='projects-title'>Projects</h2>
			<a class='quiet-link' href='https://github.com/ethrmor'>More on GitHub <span class='arrow'>→</span></a>
		</div>
		<ProjectList projects={projects} />
	</section>

	<section class='section' aria-labelledby='writing-title'>
		<div class='section-head'>
			<h2 id='writing-title'>Writing</h2>
			<a class='quiet-link' href='/blog'>All posts <span class='arrow'>→</span></a>
		</div>
		<PostList posts={posts} />
	</section>
</BaseLayout>

<style>
	.intro h1 {
		margin-bottom: 0.4em;
		font-size: var(--fs-display);
		letter-spacing: -0.035em;
	}
	.intro p {
		max-width: 54ch;
		color: var(--ink-2);
	}
	.lede {
		color: var(--ink) !important;
		font-size: var(--fs-md);
		line-height: 1.5;
	}
	.now {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.75rem;
		margin-top: 2rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background-color: color-mix(in oklch, var(--surface) 70%, transparent);
		padding: 0.55rem 1.1rem;
		width: fit-content;
		max-width: 100% !important;
		color: var(--ink) !important;
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	.now-label {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		color: var(--accent-ink);
		font-weight: 700;
	}
	.now-label::before {
		border-radius: 50%;
		background-color: var(--accent);
		width: 7px;
		height: 7px;
		content: '';
		animation: pulse 2.6s var(--ease-out) infinite;
	}
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in oklch, var(--accent) 55%, transparent);
		}
		70%,
		100% {
			box-shadow: 0 0 0 7px transparent;
		}
	}
</style>
