---
import BaseLayout from '@layouts/BaseLayout.astro';
import { PLAYER } from '../consts';

const stats = [
	{ label: 'Team', value: PLAYER.team },
	{ label: 'No.', value: PLAYER.number },
	{ label: 'Plays', value: 'Winger' },
	{ label: 'Shoots', value: PLAYER.shoots },
	{ label: 'Since', value: PLAYER.started },
	{ label: 'Fan of', value: 'Blackhawks' },
];

const season = PLAYER.season;
const seasonStats = season
	? [
			{ label: 'GP', value: season.gp },
			{ label: 'G', value: season.g },
			{ label: 'A', value: season.a },
			{ label: 'PTS', value: season.g + season.a },
		]
	: [];

const work = [
	{
		role: 'Director of Development',
		org: 'Central States Marketing',
		years: '2021 to now',
		text: 'I started as a web developer, building custom WordPress themes in PHP for client sites, keeping older sites healthy, and leading email marketing for our clients. Now I lead development for the agency.',
	},
	{
		role: 'Financial Advisor',
		org: 'JPMorgan Chase, Charles Schwab, Edward Jones',
		years: '2013 to 2021',
		text: 'Eight years helping people grow and keep their money. It taught me sales, clear communication, and the value of hard work, all of which I still lean on today.',
	},
];
---

<BaseLayout title='About' description='Ethan Morris: director of development, dad of two, winger for the Bombers.'>
	<h1>About</h1>

	<p class='lede'>
		I'm a director of development and a dad of two. Most of my time outside work goes to my kids, and the rest lately
		goes to <a href='#hockey'>hockey</a>.
	</p>
	<p>
		My interest in the web started back in the days of dial-up. It took a detour through nearly ten years in finance
		before it became my job. A few things I've done since:
	</p>
	<ul>
		<li>Built more than 20 websites while helping maintain upwards of 400 client sites.</li>
		<li>Run client email marketing, turning agency designs into hand-coded HTML emails.</li>
		<li>Shortened the path from design to production by smoothing out how designers and developers hand off work.</li>
	</ul>

	<blockquote>
		<p>&ldquo;If you are not learning, you are not living.&rdquo;</p>
		<footer>Kevin James Breaux</footer>
	</blockquote>

	<h2>Work</h2>
	<ol class='timeline' role='list'>
		{
			work.map((job) => (
				<li>
					<div class='when meta tabular'>{job.years}</div>
					<div>
						<h3>{job.role}</h3>
						<p class='org'>{job.org}</p>
						<p>{job.text}</p>
					</div>
				</li>
			))
		}
	</ol>

	<section id='hockey' class='hockey' aria-labelledby='hockey-title'>
		<h2 id='hockey-title'>Hockey</h2>
		<p>
			I started playing in {PLAYER.started}, at 36. I'm a winger for the {PLAYER.team}, number {PLAYER.number}. Away from the rink, I cheer
			for the {PLAYER.favorite}.
		</p>
		<dl class='player' aria-label='Player card'>
			{
				stats.map(({ label, value }) => (
					<div>
						<dt>{label}</dt>
						<dd>{value}</dd>
					</div>
				))
			}
		</dl>
		{
			season && (
				<dl class='player season' aria-label={`${season.label} season`}>
					<div class='season-label'>
						<dt>Season</dt>
						<dd>{season.label}</dd>
					</div>
					{seasonStats.map(({ label, value }) => (
						<div>
							<dt>{label}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</section>
</BaseLayout>

<style>
	p,
	li {
		color: var(--ink-2);
	}
	.lede {
		color: var(--ink);
		font-size: var(--fs-md);
		line-height: 1.5;
	}

	/* The back of a hockey card. */
	.hockey {
		margin-top: 3.5rem;
		border-top: 1px solid var(--line);
		padding-top: 2.5rem;
	}
	.player {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		margin: 1.5rem 0 0;
		border: 1px solid var(--line);
		border-top: 4px solid var(--accent);
		border-radius: 0 0 var(--radius) var(--radius);
		background: var(--surface);
	}
	.player div {
		padding: 0.75rem 1rem 0.85rem;
	}
	.player div + div {
		border-left: 1px solid var(--line);
	}
	dt {
		color: var(--ink-3);
		font-weight: 600;
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	dd {
		margin: 0.1rem 0 0;
		font-weight: 750;
		font-size: var(--fs-md);
		letter-spacing: -0.01em;
		font-variant-numeric: tabular-nums;
	}

	.season {
		grid-template-columns: 1.4fr repeat(4, 1fr);
		margin-top: 0.75rem;
		border-top: 1px solid var(--line);
		border-radius: var(--radius);
	}
	blockquote {
		margin-block: 3.5rem;
		border-block: 1px solid var(--line);
		padding-block: 2rem;
		font-size: var(--fs-lg);
	}
	blockquote p {
		color: var(--ink);
	}
	h2 {
		margin-top: 1rem;
	}
	.timeline {
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.timeline li {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1.5rem;
		margin: 0;
		border-top: 1px solid var(--line);
		padding-block: 1.5rem;
	}
	.timeline h3 {
		margin-bottom: 0.15em;
	}
	.when {
		padding-top: 0.25em;
	}
	.org {
		margin-bottom: 0.75em;
		color: var(--ink-3);
		font-size: var(--fs-sm);
	}
	@media (max-width: 640px) {
		.player {
			grid-template-columns: repeat(3, 1fr);
		}
		.player div:nth-child(4) {
			border-left: 0;
		}
		.player div:nth-child(n + 4) {
			border-top: 1px solid var(--line);
		}
	}
	@media (max-width: 560px) {
		.timeline li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
