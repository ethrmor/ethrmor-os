---
import BaseLayout from '@layouts/BaseLayout.astro';

const work = [
	{
		role: 'Web Developer',
		org: 'Central States Marketing',
		years: '2021 to now',
		text: 'I build custom WordPress themes in PHP for client sites, keep older sites healthy and up to date, and lead email marketing for our clients, from writing and coding the emails to scheduling them.',
	},
	{
		role: 'Financial Advisor',
		org: 'JPMorgan Chase, Charles Schwab, Edward Jones',
		years: '2013 to 2021',
		text: 'Eight years helping people grow and keep their money. It taught me sales, clear communication, and the value of hard work, all of which I still lean on as a developer.',
	},
];
---

<BaseLayout title='About' description='Ethan Morris: web developer, former financial advisor.'>
	<h1>About</h1>
	<p class='lede'>
		My interest in the web started back in the days of dial-up. It took a detour through nearly ten years in finance
		before it became my job.
	</p>
	<p>A few things I've done along the way:</p>
	<ul>
		<li>Built more than 20 websites while helping maintain upwards of 400 client sites.</li>
		<li>Run client email marketing, turning agency designs into hand-coded HTML emails.</li>
		<li>Shortened the path from design to production by smoothing out how designers and developers hand off work.</li>
	</ul>

	<blockquote class='popout'>
		<p>&ldquo;If you are not learning, you are not living.&rdquo;</p>
		<footer>Kevin James Breaux</footer>
	</blockquote>

	<h2>Work</h2>
	<ol class='timeline' role='list'>
		{
			work.map((job) => (
				<li>
					<div class='when meta tabular'>{job.years}</div>
					<div>
						<h3>{job.role}</h3>
						<p class='org'>{job.org}</p>
						<p>{job.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</BaseLayout>

<style>
	.lede {
		font-size: var(--fs-md);
		line-height: 1.5;
	}
	p,
	li {
		color: var(--ink-2);
	}
	.lede {
		color: var(--ink);
	}
	blockquote {
		margin-block: 3.5rem;
		border-block: 1px solid var(--line);
		padding-block: 2rem;
		font-size: var(--fs-lg);
	}
	blockquote p {
		color: var(--ink);
	}
	h2 {
		margin-top: 1rem;
	}
	.timeline {
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.timeline li {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1.5rem;
		margin: 0;
		border-top: 1px solid var(--line);
		padding-block: 1.5rem;
	}
	.timeline h3 {
		margin-bottom: 0.15em;
	}
	.when {
		padding-top: 0.25em;
	}
	.org {
		margin-bottom: 0.75em;
		color: var(--ink-3);
		font-size: var(--fs-sm);
	}
	@media (max-width: 560px) {
		.timeline li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
