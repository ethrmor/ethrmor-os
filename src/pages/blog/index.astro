---
import PostList from '@components/PostList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPosts, tagSlug } from '../../lib/posts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
---

<BaseLayout title='Writing' description='Notes on CSS, interaction details, and the things I am building.'>
	<header class='page-head'>
		<h1>Writing</h1>
		<p>Notes on CSS, interaction details, and whatever I'm building at the moment. Short, practical, and usually written right after I figured something out.</p>
		{
			tags.length > 0 && (
				<p class='tags'>
					{tags.map((tag) => (
						<a href={`/blog/tags/${tagSlug(tag)}/`}>#{tag}</a>
					))}
				</p>
			)
		}
	</header>
	<PostList posts={posts} />
</BaseLayout>

<style>
	.page-head {
		margin-bottom: 2.5rem;
	}
	.page-head p {
		max-width: 56ch;
		color: var(--ink-2);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tags a {
		border-radius: 999px;
		background-color: var(--surface-2);
		padding: 0.2rem 0.7rem;
		color: var(--ink-2);
		font-weight: 550;
		font-size: var(--fs-xs);
		text-decoration: none;
	}
	.tags a:hover {
		background-color: var(--accent-wash);
		color: var(--accent-ink);
	}
</style>
