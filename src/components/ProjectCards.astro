---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const status = { live: 'Live', 'in progress': 'In progress', internal: 'Internal tool' } as const;
---

<div class='deck full'>
	<div class='section-head'>
		<slot name='head' />
		<div class='controls'>
		<button type='button' class='nudge' data-dir='-1' aria-label='Previous projects'>
			<svg width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'
				><path d='M13 8H3.5M7.5 3.5 3 8l4.5 4.5' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'></path></svg
			>
		</button>
		<button type='button' class='nudge' data-dir='1' aria-label='Next projects'>
			<svg width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'
				><path d='M3 8h9.5M8.5 3.5 13 8l-4.5 4.5' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'></path></svg
			>
		</button>
		</div>
	</div>

	<ul class='cards' role='list' aria-label='Projects'>
		{
			projects.map((project, i) => (
				<li class='card'>
					<a href={project.data.url ?? project.data.repo} class='face'>
						<span class='photo'>
							<Image
								src={project.data.image}
								alt={project.data.imageAlt}
								widths={[360, 720]}
								sizes='320px'
								loading={i < 2 ? 'eager' : 'lazy'}
							/>
							<span class='status' data-status={project.data.status}>
								{status[project.data.status]}
							</span>
						</span>
						<span class='plate'>
							<span class='name'>{project.data.title}</span>
							<span class='set'>
								{String(i + 1).padStart(2, '0')}/{String(projects.length).padStart(2, '0')}
							</span>
						</span>
						<span class='summary'>{project.data.summary}</span>
						<span class='stats'>
							<span>
								<span class='label'>Year</span>
								{project.data.year}
							</span>
							<span>
								<span class='label'>Built with</span>
								{project.data.stack}
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	function setup() {
		document.querySelectorAll<HTMLElement>('.deck').forEach((deck) => {
			if (deck.dataset.ready) return;
			deck.dataset.ready = 'true';
			const list = deck.querySelector<HTMLElement>('.cards');
			if (!list) return;

			const update = () => {
				const max = list.scrollWidth - list.clientWidth - 2;
				deck.querySelector<HTMLButtonElement>('[data-dir="-1"]')!.disabled = list.scrollLeft <= 2;
				deck.querySelector<HTMLButtonElement>('[data-dir="1"]')!.disabled = list.scrollLeft >= max;
			};
			list.addEventListener('scroll', update, { passive: true });
			update();

			deck.querySelectorAll<HTMLButtonElement>('.nudge').forEach((button) => {
				button.addEventListener('click', () => {
					const card = list.querySelector<HTMLElement>('.card');
					const step = (card?.offsetWidth ?? 300) + 20;
					list.scrollBy({ left: step * Number(button.dataset.dir), behavior: 'smooth' });
				});
			});

			// A little tilt toward the pointer, like turning a card in your hand.
			if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
				list.querySelectorAll<HTMLElement>('.face').forEach((face) => {
					face.addEventListener('pointermove', (event) => {
						const box = face.getBoundingClientRect();
						const x = (event.clientX - box.left) / box.width - 0.5;
						const y = (event.clientY - box.top) / box.height - 0.5;
						face.style.setProperty('--ry', `${x * 7}deg`);
						face.style.setProperty('--rx', `${y * -7}deg`);
					});
					face.addEventListener('pointerleave', () => {
						face.style.setProperty('--ry', '0deg');
						face.style.setProperty('--rx', '0deg');
					});
				});
			}
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>

<style>
	.deck {
		position: relative;
	}
	.controls {
		display: flex;
		gap: 0.4rem;
	}
	.nudge {
		display: grid;
		place-items: center;
		cursor: pointer;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--bg);
		width: 2.25rem;
		height: 2.25rem;
		color: var(--ink);
		transition:
			border-color 200ms var(--ease-out),
			opacity 200ms var(--ease-out);
	}
	.nudge:hover:not(:disabled) {
		border-color: var(--ink-3);
	}
	.nudge:disabled {
		cursor: default;
		opacity: 0.35;
	}
	.cards {
		display: flex;
		grid-column: full;
		gap: 20px;
		margin: 0;
		padding: 0.5rem calc((100% - var(--grid-content)) / 2) 1.5rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-padding-inline: calc((100% - var(--grid-content)) / 2);
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		list-style: none;
	}
	.cards::-webkit-scrollbar {
		display: none;
	}
	.card {
		flex: 0 0 min(300px, 78vw);
		margin: 0;
		perspective: 900px;
		scroll-snap-align: start;
	}
	.face {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--surface);
		padding: 10px 10px 14px;
		height: 100%;
		color: var(--ink);
		text-decoration: none;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 500ms var(--ease-out),
			box-shadow 400ms var(--ease-out),
			border-color 300ms var(--ease-out);
	}
	.face:hover {
		border-color: var(--line-strong);
		box-shadow: var(--shadow);
	}
	.photo {
		display: block;
		position: relative;
		border: 1px solid var(--line);
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg);
	}
	.photo::after {
		/* The trim stripe along the bottom of the photo. */
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		background: var(--accent);
		height: 4px;
		content: '';
	}
	.photo :global(img) {
		aspect-ratio: 4 / 3;
		width: 100%;
		object-fit: cover;
		object-position: top left;
	}
	:global([data-theme='dark']) .photo :global(img) {
		filter: brightness(0.86);
	}
	.photo .status {
		position: absolute;
		top: 8px;
		left: 8px;
		border-radius: 999px;
		background: var(--bg);
		padding: 0.15rem 0.55rem;
		color: var(--ink-2);
		box-shadow: 0 1px 2px oklch(0% 0 0 / 0.12);
	}
	.plate {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		padding-inline: 4px;
	}
	.name {
		font-weight: 750;
		font-size: 1.125rem;
		line-height: 1.2;
		letter-spacing: -0.015em;
	}
	.set {
		color: var(--ink-3);
		font-weight: 600;
		font-size: var(--fs-xs);
		font-variant-numeric: tabular-nums;
	}
	.summary {
		flex: 1;
		padding-inline: 4px;
		color: var(--ink-2);
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	.stats {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		margin-inline: 4px;
		border-top: 1px solid var(--line);
		padding-top: 0.65rem;
		font-weight: 600;
		font-size: var(--fs-sm);
		font-variant-numeric: tabular-nums;
	}
	.label {
		display: block;
		color: var(--ink-3);
		font-weight: 600;
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
</style>
