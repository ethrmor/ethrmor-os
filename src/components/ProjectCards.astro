---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const status = { live: 'Live', 'in progress': 'In progress', internal: 'Internal tool' } as const;
const cardNo = (i: number) => String(i + 1).padStart(2, '0');
const host = (url: string) => new URL(url).host;
---

<div class='deck full'>
	<div class='section-head'>
		<slot name='head' />
		<div class='controls'>
			<button type='button' class='nudge' data-dir='-1' aria-label='Previous projects'>
				<svg width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'
					><path
						d='M13 8H3.5M7.5 3.5 3 8l4.5 4.5'
						fill='none'
						stroke='currentColor'
						stroke-width='1.6'
						stroke-linecap='round'
						stroke-linejoin='round'></path></svg
				>
			</button>
			<button type='button' class='nudge' data-dir='1' aria-label='Next projects'>
				<svg width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'
					><path
						d='M3 8h9.5M8.5 3.5 13 8l-4.5 4.5'
						fill='none'
						stroke='currentColor'
						stroke-width='1.6'
						stroke-linecap='round'
						stroke-linejoin='round'></path></svg
				>
			</button>
		</div>
	</div>

	<ul class='cards' role='list' aria-label='Projects'>
		{
			projects.map((project, i) => (
				<li class='card'>
					<div class='tilt'>
						<div class='inner'>
							{/* Front: the photo and the basics. Click to flip. */}
							<button type='button' class='face front' aria-label={`${project.data.title}: flip card for details`}>
								<span class='photo'>
									<Image
										src={project.data.image}
										alt={project.data.imageAlt}
										widths={[360, 720]}
										sizes='320px'
										loading={i < 2 ? 'eager' : 'lazy'}
									/>
								</span>
								<span class='plate'>
									<span class='name'>{project.data.title}</span>
									<span class='status' data-status={project.data.status}>
										{status[project.data.status]}
									</span>
								</span>
								<span class='stats'>
									<span>
										<span class='label'>Year</span>
										{project.data.year}
									</span>
									<span>
										<span class='label'>Built with</span>
										{project.data.stack}
									</span>
									<span class='set'>
										<span class='label'>Card</span>
										{cardNo(i)}
									</span>
								</span>
								<span class='flip-hint' aria-hidden='true'>
									Flip
									<svg width='14' height='14' viewBox='0 0 16 16'>
										<path
											d='M2.5 6.5A5.5 5.5 0 0 1 13 5M13.5 9.5A5.5 5.5 0 0 1 3 11M13 2v3h-3M3 14v-3h3'
											fill='none'
											stroke='currentColor'
											stroke-width='1.5'
											stroke-linecap='round'
											stroke-linejoin='round'
										/>
									</svg>
								</span>
							</button>

							{/* Back: the write-up and the links, like the back of a real card. */}
							<div class='face back' inert>
								<div class='back-head'>
									<span class='name'>{project.data.title}</span>
									<span class='set'>No. {cardNo(i)}</span>
								</div>
								<p class='summary'>{project.data.summary}</p>
								<dl class='back-stats'>
									<div>
										<dt class='label'>Status</dt>
										<dd>{status[project.data.status]}</dd>
									</div>
									<div>
										<dt class='label'>Year</dt>
										<dd>{project.data.year}</dd>
									</div>
									<div>
										<dt class='label'>Built with</dt>
										<dd>{project.data.stack}</dd>
									</div>
								</dl>
								<p class='links'>
									{project.data.url && (
										<a class='quiet-link' href={project.data.url}>
											{project.data.status === 'internal' ? 'Open tool' : host(project.data.url)}{' '}
											<span class='arrow'>↗</span>
										</a>
									)}
									{project.data.repo && (
										<a class='quiet-link' href={project.data.repo}>
											Source <span class='arrow'>↗</span>
										</a>
									)}
								</p>
								<button type='button' class='flip-back quiet-link'>
									<span class='arrow'>←</span> Flip back
								</button>
							</div>
						</div>
					</div>
				</li>
			))
		}
	</ul>
</div>

<script>
	function setup() {
		document.querySelectorAll<HTMLElement>('.deck').forEach((deck) => {
			if (deck.dataset.ready) return;
			deck.dataset.ready = 'true';
			const list = deck.querySelector<HTMLElement>('.cards');
			if (!list) return;

			const update = () => {
				const max = list.scrollWidth - list.clientWidth - 2;
				deck.querySelector<HTMLButtonElement>('[data-dir="-1"]')!.disabled = list.scrollLeft <= 2;
				deck.querySelector<HTMLButtonElement>('[data-dir="1"]')!.disabled = list.scrollLeft >= max;
			};
			list.addEventListener('scroll', update, { passive: true });
			update();

			deck.querySelectorAll<HTMLButtonElement>('.nudge').forEach((button) => {
				button.addEventListener('click', () => {
					const card = list.querySelector<HTMLElement>('.card');
					const step = (card?.offsetWidth ?? 300) + 20;
					list.scrollBy({ left: step * Number(button.dataset.dir), behavior: 'smooth' });
				});
			});

			// Flip a card over. Only the side facing you can be tabbed into.
			list.querySelectorAll<HTMLElement>('.card').forEach((card) => {
				const front = card.querySelector<HTMLButtonElement>('.front')!;
				const back = card.querySelector<HTMLElement>('.back')!;
				const flip = (flipped: boolean) => {
					card.classList.toggle('is-flipped', flipped);
					front.inert = flipped;
					back.inert = !flipped;
					(flipped ? back.querySelector<HTMLElement>('a, button') : front)?.focus({ preventScroll: true });
				};
				front.addEventListener('click', () => flip(true));
				card.querySelector('.flip-back')!.addEventListener('click', () => flip(false));
				card.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && card.classList.contains('is-flipped')) flip(false);
				});
			});

			// A little tilt toward the pointer, like turning a card in your hand.
			if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
				list.querySelectorAll<HTMLElement>('.tilt').forEach((tilt) => {
					tilt.addEventListener('pointermove', (event) => {
						const box = tilt.getBoundingClientRect();
						const x = (event.clientX - box.left) / box.width - 0.5;
						const y = (event.clientY - box.top) / box.height - 0.5;
						tilt.style.setProperty('--ry', `${x * 7}deg`);
						tilt.style.setProperty('--rx', `${y * -7}deg`);
					});
					tilt.addEventListener('pointerleave', () => {
						tilt.style.setProperty('--ry', '0deg');
						tilt.style.setProperty('--rx', '0deg');
					});
				});
			}
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>

<style>
	.deck {
		position: relative;
	}
	.controls {
		display: flex;
		gap: 0.4rem;
	}
	.nudge {
		display: grid;
		place-items: center;
		cursor: pointer;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--bg);
		width: 2.25rem;
		height: 2.25rem;
		color: var(--ink);
		transition:
			border-color 200ms var(--ease-out),
			opacity 200ms var(--ease-out);
	}
	.nudge:hover:not(:disabled) {
		border-color: var(--ink-3);
	}
	.nudge:disabled {
		cursor: default;
		opacity: 0.35;
	}
	.cards {
		display: flex;
		grid-column: full;
		gap: 20px;
		margin: 0;
		padding: 0.5rem calc((100% - var(--grid-content)) / 2) 1.5rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-padding-inline: calc((100% - var(--grid-content)) / 2);
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		list-style: none;
	}
	.cards::-webkit-scrollbar {
		display: none;
	}
	.card {
		flex: 0 0 min(300px, 78vw);
		margin: 0;
		perspective: 1000px;
		scroll-snap-align: start;
	}
	.tilt {
		height: 100%;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transform-style: preserve-3d;
		transition: transform 500ms var(--ease-out);
	}
	.inner {
		display: grid;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 700ms var(--ease-out);
	}
	.card.is-flipped .inner {
		transform: rotateY(180deg);
	}
	.face {
		display: flex;
		grid-area: 1 / 1;
		flex-direction: column;
		gap: 0.75rem;
		backface-visibility: hidden;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--surface);
		padding: 10px 10px 14px;
		color: var(--ink);
		font: inherit;
		text-align: left;
		transition:
			box-shadow 400ms var(--ease-out),
			border-color 300ms var(--ease-out);
	}
	.front {
		cursor: pointer;
	}
	.tilt:hover .face {
		border-color: var(--line-strong);
		box-shadow: var(--shadow);
	}
	.back {
		transform: rotateY(180deg);
		padding: 18px 16px 16px;
	}
	.photo {
		display: block;
		position: relative;
		border: 1px solid var(--line);
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg);
	}
	.photo::after {
		/* The trim stripe along the bottom of the photo. */
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		background: var(--accent);
		height: 4px;
		content: '';
	}
	.photo :global(img) {
		aspect-ratio: 4 / 3;
		width: 100%;
		object-fit: cover;
		object-position: top left;
	}
	:global([data-theme='dark']) .photo :global(img) {
		filter: brightness(0.86);
	}
	.plate {
		display: grid;
		flex: 1;
		align-content: start;
		gap: 0.2rem;
		padding-inline: 4px;
	}
	.name {
		font-weight: 750;
		font-size: 1.125rem;
		line-height: 1.2;
		letter-spacing: -0.015em;
	}
	.stats {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		margin-inline: 4px;
		border-top: 1px solid var(--line);
		padding-top: 0.65rem;
		font-weight: 600;
		font-size: var(--fs-sm);
		font-variant-numeric: tabular-nums;
	}
	.set {
		color: var(--ink-3);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.label {
		display: block;
		color: var(--ink-3);
		font-weight: 600;
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.flip-hint {
		display: inline-flex;
		position: absolute;
		top: 18px;
		right: 18px;
		align-items: center;
		gap: 0.3rem;
		translate: 0 -3px;
		border-radius: 999px;
		background: var(--bg);
		padding: 0.15rem 0.55rem;
		color: var(--ink-2);
		font-weight: 600;
		font-size: var(--fs-xs);
		box-shadow: 0 1px 2px oklch(0% 0 0 / 0.15);
		opacity: 0;
		transition:
			opacity 250ms var(--ease-out),
			translate 350ms var(--ease-out);
	}
	.front {
		position: relative;
	}
	.front:hover .flip-hint,
	.front:focus-visible .flip-hint {
		translate: 0 0;
		opacity: 1;
	}
	@media (hover: none) {
		.flip-hint {
			translate: 0 0;
			opacity: 1;
		}
	}

	/* Back of the card */
	.back-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		border-bottom: 4px solid var(--accent);
		padding-bottom: 0.6rem;
	}
	.back .set {
		font-weight: 600;
		font-size: var(--fs-xs);
	}
	.summary {
		flex: 1;
		margin: 0;
		color: var(--ink-2);
		font-size: var(--fs-sm);
		line-height: 1.55;
	}
	.back-stats {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		font-weight: 600;
		font-size: var(--fs-sm);
	}
	.back-stats div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px dashed var(--line);
		padding-bottom: 0.35rem;
	}
	.back-stats dd {
		margin: 0;
		text-align: right;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0;
	}
	.flip-back {
		align-self: flex-start;
		cursor: pointer;
		border: 0;
		background: none;
		padding: 0;
		font-family: inherit;
	}
	.flip-back:hover .arrow {
		translate: -3px 0;
	}
</style>
