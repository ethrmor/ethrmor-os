---
import { SOCIAL } from '../consts';

const year = new Date().getFullYear();

const sitemap = [
	{ href: '/', label: '/home' },
	{ href: '/blog', label: '/blog' },
	{ href: '/about', label: '/about' },
	{ href: '/rss.xml', label: '/rss' },
];

const connect = [
	{ href: SOCIAL.github, label: 'GitHub' },
	{ href: SOCIAL.linkedin, label: 'LinkedIn' },
	{ href: SOCIAL.x, label: 'X' },
];
---

<footer class='layout-grid'>
	<div class='inner'>
		<div class='about'>
			<p class='colophon'>
				Set in Manrope. Built with <a href='https://astro.build'>Astro</a> and hosted on Cloudflare.{' '}
				<a href='https://github.com/ethrmor/ethrmor-os'>View source</a>.
			</p>
			<p>&copy; {year} Ethan Morris</p>
		</div>
		<nav aria-labelledby='footer-sitemap'>
			<h2 id='footer-sitemap'>Sitemap</h2>
			<ul>
				{
					sitemap.map(({ href, label }) => (
						<li>
							<a href={href} class='path'>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<nav aria-labelledby='footer-connect'>
			<h2 id='footer-connect'>Connect</h2>
			<ul>
				{
					connect.map(({ href, label }) => (
						<li>
							<a href={href} rel='me'>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</footer>

<style>
	.inner {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: start;
		gap: 2rem clamp(2rem, 6vw, 4.5rem);
		border-top: 1px solid var(--line);
		padding-block: 2.25rem 4rem;
		color: var(--ink-3);
		font-size: var(--fs-sm);
	}
	h2 {
		margin: 0 0 0.6rem;
		color: var(--ink);
		font-weight: 700;
		font-size: var(--fs-sm);
		letter-spacing: 0;
	}
	ul {
		display: grid;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
	}
	a {
		color: var(--ink-2);
		text-decoration-color: transparent;
	}
	a:hover {
		color: var(--ink);
		text-decoration-color: var(--accent);
	}
	.path {
		font-variant-ligatures: none;
	}
	.about {
		max-width: 30ch;
	}
	.about p {
		margin: 0 0 0.6rem;
	}
	@media (max-width: 640px) {
		.inner {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
