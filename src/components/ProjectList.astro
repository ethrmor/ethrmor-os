---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const [featured, ...rest] = projects;

const statusLabel = ({ status, year }: CollectionEntry<'projects'>['data']) =>
	`${{ live: 'Live', 'in progress': 'In progress', internal: 'Internal tool' }[status]}, ${year}`;
---

{
	featured && (
		<article class='featured full'>
			<a href={featured.data.url} class='shot' tabindex='-1' aria-hidden='true'>
				<Image
					src={featured.data.image}
					alt=''
					widths={[640, 960, 1280, 1600]}
					sizes='(min-width: 960px) 880px, 100vw'
					loading='eager'
				/>
			</a>
			<div class='featured-text'>
				<div class='featured-head'>
					<h3>
						<a href={featured.data.url}>{featured.data.title}</a>
					</h3>
					<span class='status' data-status={featured.data.status}>
						{statusLabel(featured.data)}
					</span>
				</div>
				<p>{featured.data.summary}</p>
				<p class='links'>
					{featured.data.url && (
						<a class='quiet-link' href={featured.data.url}>
							{new URL(featured.data.url).host} <span class='arrow'>↗</span>
						</a>
					)}
					{featured.data.repo && (
						<a class='quiet-link' href={featured.data.repo}>
							Source
						</a>
					)}
				</p>
				<p class='sr-only'>{featured.data.imageAlt}</p>
			</div>
		</article>
	)
}

<ul class='others' role='list'>
	{
		rest.map((project) => (
			<li>
				<a href={project.data.url ?? project.data.repo}>
					<span class='thumb'>
						<Image src={project.data.image} alt='' widths={[240, 480]} sizes='160px' />
					</span>
					<span class='body'>
						<span class='name'>{project.data.title}</span>
						<span class='summary'>{project.data.summary}</span>
					</span>
					<span class='status' data-status={project.data.status}>
						{statusLabel(project.data)}
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	/* Featured project: the one with the best story gets the room. */
	.featured {
		margin-bottom: 3rem;
	}
	.shot {
		display: block;
		grid-column: feature;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		overflow: hidden;
		box-shadow: var(--shadow);
	}
	:global([data-theme='dark']) .shot :global(img) {
		filter: brightness(0.86);
	}
	.shot :global(img) {
		aspect-ratio: 16 / 9;
		width: 100%;
		object-fit: cover;
		object-position: top left;
		transition: scale 900ms var(--ease-out);
	}
	.featured:has(a:hover) .shot :global(img) {
		scale: 1.015;
	}
	.featured-text {
		margin-top: 1.4rem;
		max-width: 60ch;
	}
	.featured-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.9rem;
		margin-bottom: 0.4rem;
	}
	.featured h3 {
		margin: 0;
		font-size: var(--fs-lg);
	}
	.featured h3 a {
		text-decoration: none;
	}
	.featured h3 a:hover {
		color: var(--accent-ink);
	}
	.featured p {
		color: var(--ink-2);
	}
	.links {
		display: flex;
		gap: 1.25rem;
		margin: 0;
	}

	/* The rest: a plain list, smaller and quieter. */
	.others {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.others li {
		margin: 0;
	}
	.others a {
		display: grid;
		grid-template-columns: 7.5rem 1fr auto;
		align-items: center;
		gap: 1.25rem;
		margin-inline: -0.75rem;
		border-radius: var(--radius);
		padding: 0.75rem;
		text-decoration: none;
		transition: background-color 250ms var(--ease-out);
	}
	.others a:hover {
		background-color: var(--surface);
	}
	.thumb {
		display: block;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		overflow: hidden;
	}
	.thumb :global(img) {
		aspect-ratio: 16 / 10;
		width: 100%;
		object-fit: cover;
		object-position: top left;
		transition: scale 700ms var(--ease-out);
	}
	.others a:hover .thumb :global(img) {
		scale: 1.04;
	}
	.body {
		display: grid;
		gap: 0.15rem;
	}
	.name {
		color: var(--ink);
		font-weight: 650;
		letter-spacing: -0.01em;
	}
	.others a:hover .name {
		color: var(--accent-ink);
	}
	.summary {
		color: var(--ink-2);
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	@media (max-width: 600px) {
		.others a {
			grid-template-columns: 5.5rem 1fr;
			align-items: start;
		}
		.others .status {
			grid-column: 2;
		}
	}
</style>
