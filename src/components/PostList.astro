---
import FormattedDate from './FormattedDate.astro';
import { readingTime, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class='post-list' role='list'>
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class='title' transition:name={`post-title-${post.id}`}>
						{post.data.title}
					</span>
					<span class='description'>{post.data.description}</span>
					<span class='meta'>
						<FormattedDate date={post.data.pubDate} style='short' />
						<span aria-hidden='true'>·</span>
						<span>{readingTime(post)} min read</span>
					</span>
					<svg class='arrow' width='16' height='16' viewBox='0 0 16 16' aria-hidden='true'>
						<path d='M3 8h9.5M8.5 3.5 13 8l-4.5 4.5' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' />
					</svg>
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		margin: 0;
		border-top: 1px solid var(--line);
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
		border-bottom: 1px solid var(--line);
	}
	a {
		display: grid;
		position: relative;
		grid-template-columns: 1fr auto;
		gap: 0.2rem 1.5rem;
		margin-inline: -0.75rem;
		border-radius: var(--radius-sm);
		padding: 1.1rem 0.75rem;
		text-decoration: none;
		transition: background-color 250ms var(--ease-out);
	}
	a:hover {
		background-color: var(--surface);
	}
	.title {
		grid-column: 1;
		width: fit-content;
		color: var(--ink);
		font-weight: 650;
		font-size: var(--fs-md);
		line-height: 1.3;
		letter-spacing: -0.012em;
		text-wrap: balance;
	}
	.description {
		grid-column: 1;
		color: var(--ink-2);
		font-size: var(--fs-sm);
		line-height: 1.55;
	}
	.meta {
		display: flex;
		grid-row: 1;
		grid-column: 2;
		align-items: baseline;
		gap: 0.45em;
		padding-top: 0.2em;
		white-space: nowrap;
	}
	.arrow {
		position: absolute;
		right: 0.75rem;
		bottom: 1.25rem;
		translate: -6px 0;
		opacity: 0;
		color: var(--accent);
		transition:
			opacity 250ms var(--ease-out),
			translate 350ms var(--ease-out);
	}
	a:hover .arrow,
	a:focus-visible .arrow {
		translate: 0 0;
		opacity: 1;
	}
	@media (max-width: 600px) {
		a {
			grid-template-columns: 1fr;
		}
		.meta {
			grid-row: auto;
			grid-column: 1;
			order: -1;
		}
		.arrow {
			display: none;
		}
	}
</style>
