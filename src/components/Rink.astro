---
// A corner of a hockey rink seen from above: the boards, the goal line and
// crease, and one faceoff circle. It stands in for the old
// background grid, drawn faintly behind the top of every page.
---

<div class='rink' aria-hidden='true'>
	<svg viewBox='0 0 800 600' preserveAspectRatio='xMaxYMin meet' fill='none'>
		<!-- Boards, with the rounded corner -->
		<path class='boards' d='M0 40H560a200 200 0 0 1 200 200V600'></path>

		<!-- Goal line and crease -->
		<path class='red' d='M672 76V600'></path>
		<path class='crease' d='M672 325a40 40 0 0 0 0 80'></path>
		<rect class='red' x='672' y='347' width='18' height='36' rx='4'></rect>

		<!-- Faceoff circle with hash marks and dot -->
		<circle class='red' cx='549' cy='230' r='92'></circle>
		<path class='red' d='M529 138v-14M569 138v-14M529 322v14M569 322v14'></path>
		<path class='red' d='M525 216h-16v-12M573 216h16v-12M525 244h-16v12M573 244h16v12'></path>
		<circle class='dot' cx='549' cy='230' r='9'></circle>
	</svg>
</div>

<style>
	.rink {
		position: absolute;
		top: 3.5rem;
		right: 0;
		left: 0;
		z-index: -1;
		overflow: hidden;
		mask-image: linear-gradient(to bottom, #000 35%, transparent 95%), linear-gradient(to left, #000 40%, transparent);
		mask-composite: intersect;
		pointer-events: none;
	}
	svg {
		display: block;
		margin-left: auto;
		width: min(860px, 75vw);
		height: auto;
	}
	.boards {
		stroke: var(--line-strong);
		stroke-width: 2;
	}
	.red {
		stroke: var(--rink-red);
		stroke-width: 2;
	}
	.crease {
		fill: var(--rink-blue);
		stroke: var(--rink-red);
		stroke-width: 2;
	}
	.dot {
		fill: var(--rink-red);
	}
	@media (max-width: 720px) {
		.rink {
			opacity: 0.7;
		}
		svg {
			margin-right: -35vw;
			width: 110vw;
		}
	}
</style>
