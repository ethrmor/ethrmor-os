---
// A full NHL rink seen from above, drawn to scale (1 unit = 0.1 ft):
// 200 x 85 ft, 28 ft corners, goal lines 11 ft from the boards, blue lines
// 64 ft out from the goal lines, faceoff spots 20 ft out and 22 ft off center.
// It stands in for the old background grid. A mask fades it out before it
// reaches the text, so only the right end shows beside the content column,
// and fades out before the second section.

const W = 2000;
const H = 850;
const MID = H / 2;

// Boards: a rounded rectangle inset by 1 unit so its stroke isn't clipped.
const INSET = 1;
const R = 280;

// Where a line at x meets the rounded corner, so lines end exactly on the boards.
const boardY = (x: number) => {
	const cx = x < W / 2 ? INSET + R : W - INSET - R;
	const dx = Math.abs(x - cx);
	return dx >= R ? INSET + R : INSET + R - Math.sqrt(R * R - dx * dx);
};

const ends = [
	{ goal: 110, dir: 1 },
	{ goal: W - 110, dir: -1 },
];

const zoneSpots = ends.flatMap(({ goal, dir }) => [
	{ x: goal + dir * 200, y: MID - 220 },
	{ x: goal + dir * 200, y: MID + 220 },
]);

const neutralSpots = [800, 1200].flatMap((x) => [
	{ x, y: MID - 220 },
	{ x, y: MID + 220 },
]);

// The net seen from above: 6 ft wide on the goal line, the base frame
// curving back about 3.7 ft behind it.
const net = (goal: number, dir: number) => {
	const b = goal - dir * 37;
	const c = goal - dir * 22;
	return `M${goal} ${MID - 30}H${c}Q${b} ${MID - 30} ${b} ${MID - 15}V${MID + 15}Q${b} ${MID + 30} ${c} ${MID + 30}H${goal}`;
};

// The hidden goal starts from the right end's top faceoff spot.
const GOAL_SPOT = 2;
const spot = zoneSpots[GOAL_SPOT];
const shot = { x: W - 110 + 16 - spot.x, y: MID - spot.y };

// Hash marks on the top and bottom of a faceoff circle, and the L marks around its spot.
const hashes = (x: number, y: number) =>
	[-1, 1]
		.flatMap((side) => [
			`M${x - 29} ${y + side * 150}v${side * 20}`,
			`M${x + 29} ${y + side * 150}v${side * 20}`,
			`M${x - 20} ${y + side * 9}h-40M${x - 20} ${y + side * 9}v${side * 30}`,
			`M${x + 20} ${y + side * 9}h40M${x + 20} ${y + side * 9}v${side * 30}`,
		])
		.join('');
---

<div class='rink' aria-hidden='true' data-shot-x={shot.x} data-shot-y={shot.y}>
	<svg viewBox={`0 0 ${W} ${H}`} fill='none'>
		<defs>
			<pattern id='rink-mesh' width='7' height='7' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>
				<path class='mesh' d='M0 0V7M0 0H7'></path>
			</pattern>
		</defs>

		<!-- Boards -->
		<rect class='boards' x={INSET} y={INSET} width={W - INSET * 2} height={H - INSET * 2} rx={R}></rect>

		<!-- Center red line, blue lines -->
		<rect class='red-fill' x={W / 2 - 5} y='1' width='10' height={H - 2}></rect>
		<rect class='blue-fill' x='745' y='1' width='10' height={H - 2}></rect>
		<rect class='blue-fill' x={W - 755} y='1' width='10' height={H - 2}></rect>

		<!-- Center circle and spot -->
		<circle class='blue-line' cx={W / 2} cy={MID} r='150'></circle>
		<circle class='blue-fill' cx={W / 2} cy={MID} r='6'></circle>

		<!-- Referee's crease -->
		<path class='red' d={`M${W / 2 - 100} ${H - 1}a100 100 0 0 1 200 0`}></path>

		{
			ends.map(({ goal, dir }) => (
				<>
					{/* Goal line, crease, net, and the trapezoid behind it */}
					<path class='crease' d={`M${goal} ${MID - 60}a60 60 0 0 ${dir === 1 ? 1 : 0} 0 120`} />
					<path class='red' d={`M${goal} ${boardY(goal)}V${H - boardY(goal)}`} />
					<path class='net' d={net(goal, dir)} />
					<path class='frame' d={net(goal, dir)} />
					<path
						class='red'
						d={`M${goal} ${MID - 110}L${goal - dir * 109} ${MID - 140}M${goal} ${MID + 110}L${goal - dir * 109} ${MID + 140}`}
					/>
				</>
			))
		}

		{
			zoneSpots.map(({ x, y }, i) => (
				<>
					<circle class='red' cx={x} cy={y} r='150' />
					<path class='red' d={hashes(x, y)} />
					<circle class:list={['red-fill', { 'goal-spot': i === GOAL_SPOT }]} cx={x} cy={y} r='10' />
				</>
			))
		}

		{neutralSpots.map(({ x, y }) => <circle class='red-fill' cx={x} cy={y} r='10' />)}

		<!-- Shh. Click the faceoff dot in the top right. -->
		<rect class='goal-light' x={W - 62} y={MID - 18} width='14' height='36' rx='4'></rect>
		<circle class='puck' cx={spot.x} cy={spot.y} r='8'></circle>
	</svg>
</div>

<script>
	// A hidden goal: click the faceoff dot and a puck slides into the net.
	function setupGoal() {
		const rink = document.querySelector<HTMLElement>('.rink');
		const spot = rink?.querySelector<SVGCircleElement>('.goal-spot');
		const puck = rink?.querySelector<SVGCircleElement>('.puck');
		const light = rink?.querySelector<SVGRectElement>('.goal-light');
		if (!rink || !spot || !puck || !light || rink.dataset.ready) return;
		rink.dataset.ready = 'true';

		let busy = false;
		const hit = (event: PointerEvent | MouseEvent) => {
			if (getComputedStyle(rink).display === 'none') return false;
			const box = spot.getBoundingClientRect();
			const pad = 12;
			return (
				event.clientX > box.left - pad &&
				event.clientX < box.right + pad &&
				event.clientY > box.top - pad &&
				event.clientY < box.bottom + pad
			);
		};

		const onMove = (event: PointerEvent) => {
			if ((event.target as Element).closest('a, button, input, textarea')) return;
			document.body.style.cursor = hit(event) ? 'pointer' : '';
		};

		const onClick = (event: MouseEvent) => {
			if (busy || !hit(event) || (event.target as Element).closest('a, button')) return;
			busy = true;
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const dx = Number(rink.dataset.shotX);
			const dy = Number(rink.dataset.shotY);

			const blink = () =>
				light.animate([{ opacity: 0 }, { opacity: 1 }, { opacity: 0.25 }, { opacity: 1 }, { opacity: 0.25 }, { opacity: 1 }, { opacity: 0 }], {
					duration: 1600,
					easing: 'linear',
				}).finished;

			const shoot = reduce
				? Promise.resolve()
				: puck.animate(
						[
							{ transform: 'translate(0, 0)', opacity: 1 },
							{ transform: `translate(${dx}px, ${dy}px)`, opacity: 1, offset: 0.92 },
							{ transform: `translate(${dx}px, ${dy}px)`, opacity: 0 },
						],
						{ duration: 650, easing: 'cubic-bezier(0.3, 0.7, 0.4, 1)' },
					).finished;

			shoot.then(blink).finally(() => (busy = false));
		};

		document.addEventListener('pointermove', onMove, { passive: true });
		document.addEventListener('click', onClick);
	}

	document.addEventListener('astro:page-load', setupGoal);
</script>

<style>
	.rink {
		--text-half: calc(var(--grid-content) / 2);
		position: absolute;
		top: 4.5rem;
		right: 0;
		left: 0;
		z-index: -1;
		mask-image:
			linear-gradient(to bottom, #000 25%, transparent 72%),
			linear-gradient(
				to right,
				transparent calc(50% + var(--text-half) + 1.5rem),
				#000 calc(50% + var(--text-half) + 10rem)
			);
		mask-composite: intersect;
		display: flex;
		justify-content: flex-end;
		overflow: hidden;
		pointer-events: none;
	}
	svg {
		display: block;
		flex-shrink: 0;
		/* Pulled in from the right edge, so the end boards sit fully on screen. */
		margin-right: clamp(1rem, 2.5vw, 2.5rem);
		width: max(calc(100% - 2 * clamp(1rem, 2.5vw, 2.5rem)), 1100px);
		height: auto;
	}
	.boards {
		stroke: var(--line-strong);
		stroke-width: 3;
	}
	.red {
		stroke: var(--rink-red);
		stroke-width: 3;
	}
	.red-fill {
		fill: var(--rink-red);
	}
	.blue-fill {
		fill: var(--rink-blue);
	}
	.blue-line {
		stroke: var(--rink-blue);
		stroke-width: 3;
	}
	.net {
		fill: url(#rink-mesh);
	}
	.mesh {
		stroke: var(--line-strong);
		stroke-width: 1.2;
	}
	.frame {
		/* Solid, so the netting doesn't show through the frame. */
		stroke: var(--rink-red);
		stroke-width: 5;
		stroke-linejoin: round;
	}
	.puck {
		fill: var(--ink);
		opacity: 0;
	}
	.goal-light {
		fill: var(--accent);
		opacity: 0;
	}
	.crease {
		fill: var(--rink-blue);
		stroke: var(--rink-red);
		stroke-width: 3;
	}

	/* On phones the text spans the whole width, leaving no room beside it. */
	@media (max-width: 720px) {
		.rink {
			display: none;
		}
	}
</style>
