---
import { SOCIAL } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class='site-header layout-grid'>
	<nav class='bleed' aria-label='Main'>
		<a href='/' class='wordmark' aria-label='Ethan Morris, home'>
			<span class='bracket' aria-hidden='true'>&lt;</span>ethrmor<span class='bracket' aria-hidden='true'
				>&nbsp;/&gt;</span
			>
		</a>
		<div class='links'>
			<HeaderLink href='/blog'>Writing</HeaderLink>
			<HeaderLink href='/about'>About</HeaderLink>
			<a href={SOCIAL.github} class='icon-link' rel='me'>
				<span class='sr-only'>GitHub</span>
				<svg viewBox='0 0 16 16' aria-hidden='true' width='18' height='18'
					><path
						fill='currentColor'
						d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z'
					></path></svg
				>
			</a>
			<ThemeToggle />
		</div>
	</nav>
</header>

<script>
	// Look up the header on every call: ClientRouter swaps it on navigation.
	function updateHeader() {
		document.querySelector('.site-header')?.classList.toggle('is-scrolled', window.scrollY > 8);
	}

	window.addEventListener('scroll', updateHeader, { passive: true });
	document.addEventListener('astro:page-load', updateHeader);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		border-bottom: 1px solid transparent;
		transition:
			background-color 300ms var(--ease-out),
			border-color 300ms var(--ease-out),
			backdrop-filter 300ms var(--ease-out);
	}
	.site-header.is-scrolled {
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom-color: var(--line);
		background-color: color-mix(in oklch, var(--bg) 72%, transparent);
	}
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		min-height: 4rem;
	}
	.wordmark {
		color: var(--ink);
		font-weight: 700;
		font-size: 1.0625rem;
		letter-spacing: -0.015em;
		text-decoration: none;
	}
	.bracket {
		color: var(--ink-3);
		font-weight: 500;
		transition: color 250ms var(--ease-out);
	}
	.wordmark:hover .bracket {
		color: var(--accent);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.icon-link {
		display: grid;
		place-items: center;
		border-radius: 8px;
		width: 2.25rem;
		height: 2.25rem;
		color: var(--ink-2);
		transition:
			color 200ms var(--ease-out),
			background-color 200ms var(--ease-out);
	}
	.icon-link:hover {
		background-color: var(--surface-2);
		color: var(--ink);
	}
	@media (max-width: 420px) {
		.icon-link {
			display: none;
		}
	}
</style>
