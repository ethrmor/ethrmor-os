---

---

<button class='theme-toggle' type='button' aria-label='Switch to dark theme'>
	<svg width='18' height='18' viewBox='0 0 24 24' aria-hidden='true'>
		<mask id='theme-toggle-mask'>
			<rect width='24' height='24' fill='white'></rect>
			<circle class='moon-bite' cx='24' cy='4' r='7' fill='black'></circle>
		</mask>
		<circle class='core' cx='12' cy='12' r='5' fill='currentColor' mask='url(#theme-toggle-mask)'></circle>
		<g class='rays' stroke='currentColor' stroke-width='2' stroke-linecap='round'>
			<path d='M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M4.6 19.4 6 18M18 6l1.4-1.4'
			></path>
		</g>
	</svg>
</button>

<script>
	function sync() {
		const dark = document.documentElement.dataset.theme === 'dark';
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
			button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
		});
	}

	document.addEventListener('click', (event) => {
		const button = (event.target as Element | null)?.closest('.theme-toggle');
		if (!button) return;
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		sync();
	});

	document.addEventListener('astro:page-load', sync);
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		cursor: pointer;
		border: 0;
		border-radius: 8px;
		background: none;
		padding: 0;
		width: 2.25rem;
		height: 2.25rem;
		color: var(--ink-2);
		transition:
			color 200ms var(--ease-out),
			background-color 200ms var(--ease-out);
	}
	.theme-toggle:hover {
		background-color: var(--surface-2);
		color: var(--ink);
	}
	svg {
		overflow: visible;
	}
	.core,
	.moon-bite,
	.rays {
		transform-box: view-box;
		transform-origin: center;
		transition:
			transform 500ms var(--ease-out),
			opacity 300ms var(--ease-out),
			r 500ms var(--ease-out),
			cx 500ms var(--ease-out),
			cy 500ms var(--ease-out);
	}

	/* Dark: the sun becomes a crescent moon. */
	:global([data-theme='dark']) .core {
		r: 9px;
	}
	:global([data-theme='dark']) .moon-bite {
		cx: 17px;
		cy: 7px;
	}
	:global([data-theme='dark']) .rays {
		transform: rotate(-45deg) scale(0.6);
		opacity: 0;
	}
</style>
