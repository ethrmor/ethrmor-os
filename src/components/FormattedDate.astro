---
interface Props {
	date: Date;
	style?: 'long' | 'short';
}

const { date, style = 'long' } = Astro.props;
const options: Intl.DateTimeFormatOptions =
	style === 'short' ? { year: 'numeric', month: 'short' } : { year: 'numeric', month: 'long', day: 'numeric' };
---

<time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { ...options, timeZone: 'UTC' })}</time>
