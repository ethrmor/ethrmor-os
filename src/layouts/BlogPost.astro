---
import FormattedDate from '@components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string; minutes: number };

const { id, title, description, pubDate, updatedDate, tags, minutes } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class='progress' aria-hidden='true'></div>
	<article class='full prose'>
		<header class='post-head'>
			<a class='quiet-link back' href='/blog'><span class='arrow'>←</span> Writing</a>
			<h1 transition:name={`post-title-${id}`}>{title}</h1>
			<p class='meta'>
				<FormattedDate date={pubDate} />
				<span aria-hidden='true'>·</span>
				<span>{minutes} min read</span>
				{
					updatedDate && (
						<>
							<span aria-hidden='true'>·</span>
							<span>
								Updated <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</p>
			{
				tags && tags.length > 0 && (
					<p class='tags'>
						{tags.map((tag) => (
							<a href={`/blog/tags/${tagSlug(tag)}/`}>#{tag}</a>
						))}
					</p>
				)
			}
		</header>
		<slot />
		<footer class='post-foot'>
			<a class='quiet-link' href='/blog'><span class='arrow'>←</span> More writing</a>
		</footer>
	</article>
</BaseLayout>

<script>
	// A thin red line across the top that fills as you read, like a goal line.
	function setupProgress() {
		const bar = document.querySelector<HTMLElement>('.progress');
		const article = document.querySelector<HTMLElement>('article.prose');
		if (!bar || !article) return;
		let queued = false;
		const update = () => {
			queued = false;
			const start = article.offsetTop;
			const end = start + article.offsetHeight - innerHeight;
			const progress = Math.min(1, Math.max(0, (scrollY - start) / Math.max(1, end - start)));
			bar.style.transform = `scaleX(${progress})`;
		};
		const onScroll = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		update();
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll, { passive: true });
		document.addEventListener('astro:before-swap', () => {
			removeEventListener('scroll', onScroll);
			removeEventListener('resize', onScroll);
		}, { once: true });
	}
	document.addEventListener('astro:page-load', setupProgress);
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: calc(var(--z-header) + 1);
		transform: scaleX(0);
		transform-origin: left;
		background: var(--accent);
		width: 100%;
		height: 3px;
		pointer-events: none;
	}
	.post-head {
		margin-bottom: 2.75rem;
		border-bottom: 1px solid var(--line);
		padding-bottom: 1.75rem;
	}
	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.quiet-link:hover .arrow {
		translate: -3px 0;
	}
	h1 {
		margin-bottom: 0.6em;
		font-size: var(--fs-xl);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.5rem;
		margin-bottom: 0.9rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
	}
	.tags a {
		border-radius: 999px;
		background-color: var(--surface-2);
		padding: 0.15rem 0.65rem;
		color: var(--ink-2);
		font-weight: 550;
		font-size: var(--fs-xs);
		text-decoration: none;
	}
	.tags a:hover {
		background-color: var(--accent-wash);
		color: var(--accent-ink);
	}
	.prose :global(h2) {
		margin-top: 2.5em;
		font-size: var(--fs-lg);
	}
	.prose :global(h3) {
		margin-top: 2em;
	}
	.prose :global(:is(p, li)) {
		color: color-mix(in oklch, var(--ink) 88%, var(--ink-2));
	}
	.prose :global(pre) {
		grid-column: popout;
	}
	.post-foot {
		margin-top: 3.5rem;
		border-top: 1px solid var(--line);
		padding-top: 1.5rem;
	}
</style>
